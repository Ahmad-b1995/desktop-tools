{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "clip@ahmadcodes.com",
    "newLine": "lf",
    "removeComments": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src"]
}
